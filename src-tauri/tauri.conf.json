{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TonyMux",
  "version": "0.2.0",
  "identifier": "com.hungtvb.cmuxwins",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TonyMux",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Terminal workspaces for AI coding agents on Windows 11",
    "longDescription": "TonyMux brings the cmux-inspired workspace workflow to Windows with terminal panes, browser surfaces, development metadata, and local agent automation."
  }
}
